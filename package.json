{
  "name": "screenshotrun-mcp",
  "version": "1.0.2",
  "mcpName": "io.github.screenshotrun/screenshotrun-mcp",
  "description": "MCP server for ScreenshotRun Screenshot API — let AI agents capture website screenshots",
  "keywords": [
    "mcp",
    "screenshot",
    "api",
    "ai-agent",
    "claude",
    "cursor",
    "screenshotrun"
  ],
  "bin": {
    "screenshotrun-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "author": "ScreenshotRun <support@screenshotrun.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/screenshotrun/screenshotrun-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
